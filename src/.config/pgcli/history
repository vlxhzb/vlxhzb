+CREATE OR REPLACE VIEW inventory.v_device_numbers AS
+SELECT v.device_value_key,
+   d.device_name,
+   d.name,
+   d.facility,
+   d.facility_name,
+   d.family,
+   d.subfamily,
+   v.name AS value_name,
+   v.variable AS value_variable,
+   TO_NUMBER(COALESCE(REPLACE(TRIM(v.value),  ',', '.'), '0')) AS value_default,      
+   u.sign AS value_unit,    
+   u.value_factor,        
+   u.value_base,     
+   c.call AS value_call, 
+   c."trim" AS value_trim,    
+   d.parent_name,         
+   v.description,     
+   v.status,   
+   d.name_key,    
+   d.device_key,  
+   d.parent_key,     
+   d.device_subfamily_key,  
+   d.facility_key,   
+   u.physical_unit_list_key  
+   FROM inventory.tbl_device_value v   
+     JOIN inventory.v_devices d ON v.device_key = d.device_key 
+     LEFT JOIN inventory.tbl_device_value_conversion c ON c.device_value_key = v.device_value_key   
+     LEFT JOIN base.v_physical_units u ON u.physical_unit_list_key = v.unit_list_key    
+     WHERE upper(c.call::text) = 'TO_NUMBER'::text;
