alias grep='grep --color=auto'
alias fps='ps aux |grep '
alias mdcd='mkdir $1; cd $1'
alias taz='tar xzvf '
alias taj='tar xjvf '
alias tac='zar czvf '
alias ports='netstat -tlnp'
alias psmem='ps aux | sort -nk +4 | tail'
alias 'ps?'='ps ax | grep '
alias rdo='(cd /tmp && $1)'
alias wwwcp='wget --random-wait -r -p -e robots=off -U mozilla http://$1'
alias mnt='mount | column -t'
alias biggest='du -s * | sort -n | tail'
alias save='echo "!!" > last.sh'

alias dulf='find . -type f -print0 | xargs -0 du | sort -n | tail -10 | cut -f2 | xargs -I{} du -sh {} '
alias duld='find . -type d -print0 | xargs -0 du | sort -n | tail -10 | cut -f2 | xargs -I{} du -sh {} '

alias mksshagent='eval `ssh-agent -s`'

alias accLaunch='ssh -f -n $compress -Y ra-bii@ctl-srv2.csn31.bessy.de "launch $@"'
alias mlsLaunch='ssh -f -n $compress -Y ra-bii@ctl-srv2.csn31.bessy.de "launch $@"'
alias erlLaunch='ssh -f -n $compress -Y ra-bii@ctl-srv2.csn31.bessy.de "launch $@"'
