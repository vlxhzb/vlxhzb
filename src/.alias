unset LPATH LDOPTS

rmpath () {
  PATH=`echo $PATH | sed "s|:$1:|:|"`
}
foreach p (/opt/gnuplot/bin /opt/matlab/bin /opt/mgv/bin/X11 /opt/minicom/bin /opt/mm/bin /opt/mp/bin /opt/CC/bin)
  rmpath $p
end

export LC_ALL=de_DE.UTF-8
#export LC_MESSAGES=C
export LANG=de_DE

export CLASSPATH=/usr/share/java/junit-3.8.1.jar:$CLASSPATH
  
foreach d (/usr/{src,doc} /var/{arc,log})
  eval $d:t=$d
end
if [[ -e /etc/auto.amnt ]]
  then
    foreach d (`grep -v '^#' /etc/auto.amnt | awk '{print $1}'`)
      D=${d//-/}
      eval $D=/amnt/$d
    end
  fi

  
foreach d (/usr/{src,doc} /var/{arc,log})
  eval $d:t=$d
end
if [[ -e /etc/auto.amnt ]]
  then
    foreach d (`grep -v '^#' /etc/auto.amnt | awk '{print $1}'`)
      D=${d//-/}
      eval $D=/amnt/$d
    end
  fi

